# ====================================================================
# PITCHOS - HỆ THỐNG ĐẶT SÂN BÓNG ĐÁ (SOA / MICROSERVICES)
# FILE CẤU HÌNH MÔI TRƯỜNG TỔNG DÙNG CHUNG (.env)
# ====================================================================

# --------------------------------------------------------------------
# 1. CẤU HÌNH MYSQL DÙNG CHUNG (HÙNG QUẢN TRỊ)
# --------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# Tên 3 Database độc lập tương ứng 3 Microservice:
AUTH_DB_NAME=pitchos_user_db
PITCH_DB_NAME=pitchos_pitch_db
BOOKING_DB_NAME=pitchos_booking_db

# --------------------------------------------------------------------
# 2. CỔNG DỊCH VỤ (PORTS)
# --------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
PITCH_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083

# --------------------------------------------------------------------
# 3. GIAO TIẾP LIÊN DỊCH VỤ (INTER-SERVICE URLS)
# --------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8081
PITCH_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083

# --------------------------------------------------------------------
# 4. BẢO MẬT PHÂN QUYỀN JWT DÙNG CHUNG (LINH, HOÀNG, NHẬT)
# --------------------------------------------------------------------
# Secret Key 256-bit chuẩn HMAC-SHA256:
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Thời hạn token: 24 giờ (86400000 ms)
JWT_EXPIRATION_MS=86400000

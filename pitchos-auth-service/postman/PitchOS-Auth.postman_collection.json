          }
        },
        {
          "name": "TC14 - Tra cứu ID không tồn tại (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "const j = pm.response.json();",
                  "pm.test('Thông báo không tìm thấy', () => pm.expect(j.message).to.include('Không tìm thấy'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }],
            "url": { "raw": "{{authUrl}}/api/v1/users/999999", "host": ["{{authUrl}}"], "path": ["api", "v1", "users", "999999"] }
          }
        }
      ]
    },
    {
      "name": "4. Bàn giao liên dịch vụ (Giai đoạn 4)",
      "description": "Chứng minh token do Auth Service (8081) cấp được Pitch Service (8082) và Booking Service (8083) chấp nhận — tức hợp đồng claim role và jwt.secret đã đồng bộ toàn hệ thống.",
      "item": [
        {
          "name": "TC15 - Token Auth dùng được cho Pitch Service (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('handoverPitchName', 'Sân bàn giao ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('handoverPitchId', j.id);",
                  "pm.test('Pitch Service giải mã được token của Auth Service', () => pm.expect(j.id).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenChusan}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{handoverPitchName}}\",\n  \"pitchType\": \"san_7\",\n  \"pricePerHour\": 500000.00,\n  \"address\": \"Sân bàn giao kiểm thử liên dịch vụ\"\n}" },
            "url": { "raw": "{{pitchUrl}}/api/v1/pitches", "host": ["{{pitchUrl}}"], "path": ["api", "v1", "pitches"] }
          }
        },
        {
          "name": "TC16 - Token Auth dùng được cho Booking Service (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = (x) => String(x).padStart(2, '0');",
                  "const d = new Date(2027, 5, 1 + Math.floor(Math.random() * 300));",
                  "const ngay = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());",
                  "const h = 6 + Math.floor(Math.random() * 12);",
                  "pm.collectionVariables.set('startTime', ngay + 'T' + pad(h) + ':00:00');",
                  "pm.collectionVariables.set('endTime', ngay + 'T' + pad(h + 1) + ':00:00');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Booking Service giải mã được token và lấy đúng userId', () => {",
                  "  pm.expect(pm.response.json().id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenUser}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pitchId\": {{handoverPitchId}},\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}" },
            "url": { "raw": "{{bookingUrl}}/api/v1/bookings", "host": ["{{bookingUrl}}"], "path": ["api", "v1", "bookings"] },
            "description": "Chứng minh claim userId trong token được Booking Service dùng làm principal. Nếu Auth Service bỏ claim userId thì request này sẽ lỗi."
          }
        }
      ]
    }
  ],
  "variable": [

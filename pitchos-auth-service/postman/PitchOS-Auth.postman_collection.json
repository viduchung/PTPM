          }
        },
        {
          "name": "TC13 - Role chusan xem thông tin người khác (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('chusan được xem mọi tài khoản', () => pm.expect(pm.response.json().username).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenChusan}}" }],

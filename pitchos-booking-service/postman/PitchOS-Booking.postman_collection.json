          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.UTC(2027, 0, 1 + Math.floor(Math.random() * 365)));",
                  "const day = d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('tcStart', day + 'T18:00:00');",
                  "pm.collectionVariables.set('tcEnd', day + 'T19:30:00');",
                  "pm.collectionVariables.set('tcOverlapStart', day + 'T19:00:00');",
                  "pm.collectionVariables.set('tcOverlapEnd', day + 'T20:00:00');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",

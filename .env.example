# ====================================================================
# PITCHOS - FILE MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Bài kiểm tra số 2 (TX2) - SOA / Microservices 2026
# Người phụ trách: LINH - Kỹ sư Triển khai Container & Provider Pitch Service
# Hướng dẫn: Copy file này thành .env và chỉnh sửa cấu hình phù hợp với môi trường của bạn.
# ====================================================================

# --------------------------------------------------------------------
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL (DATABASE-PER-SERVICE)
# --------------------------------------------------------------------
# Trong mạng nội bộ Docker Compose (pitchos-network), các service kết nối trực tiếp
# qua hostname container tương ứng: mysql-auth, mysql-pitch, mysql-booking.
# Các cấu hình dưới đây áp dụng cho tài khoản và port ánh xạ ra máy chủ (host).
MYSQL_USERNAME=root
MYSQL_PASSWORD=1801

# Tên 3 cơ sở dữ liệu độc lập
AUTH_DB_NAME=pitchos_user_db
PITCH_DB_NAME=pitchos_pitch_db
BOOKING_DB_NAME=pitchos_booking_db

# Cổng ánh xạ ra máy chủ host cho các container MySQL (để dùng DBeaver / Navicat tra cứu)
MYSQL_AUTH_PORT=3307
MYSQL_PITCH_PORT=3308
MYSQL_BOOKING_PORT=3309

# Khi chạy ứng dụng trực tiếp trên máy tính cá nhân (không qua Docker), dùng cấu hình:
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --------------------------------------------------------------------
# 2. CẤU HÌNH CỔNG CÁC MICROSERVICES
# --------------------------------------------------------------------
REGISTRY_PORT=8761
AUTH_SERVICE_PORT=8081
PITCH_SERVICE_PORT=8082
PITCH_SERVICE_2_PORT=8084
BOOKING_SERVICE_PORT=8083

# --------------------------------------------------------------------
# 3. CẤU HÌNH SERVICE REGISTRY & DISCOVERY (NETFLIX EUREKA)
# --------------------------------------------------------------------
# Đường dẫn Eureka Server bên trong mạng Docker:
EUREKA_URL=http://pitchos-service-registry:8761/eureka/

# Đường dẫn Eureka Server khi chạy cục bộ trên máy host:
# EUREKA_URL=http://localhost:8761/eureka/

# --------------------------------------------------------------------
# 4. CẤU HÌNH BẢO MẬT JSON WEB TOKEN (JWT)
# --------------------------------------------------------------------
# Chuỗi bí mật mã hóa HMAC-SHA256 (Tối thiểu 256 bits = 32 ký tự hex)
# CẦN ĐỒNG BỘ GIỮA CẢ 3 DỊCH VỤ ĐỂ VERIFY TOKEN HỢP LỆ
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Thời gian sống của JWT Token (86400000 ms = 24 giờ)
JWT_EXPIRATION_MS=86400000

# --------------------------------------------------------------------
# 5. ĐỊA CHỈ TRUY CẬP TRỰC TIẾP TỪ MÁY CHỦ (POSTMAN / BROWSER)
# --------------------------------------------------------------------
REGISTRY_URL=http://localhost:8761
AUTH_SERVICE_URL=http://localhost:8081
PITCH_SERVICE_1_URL=http://localhost:8082
PITCH_SERVICE_2_URL=http://localhost:8084
BOOKING_SERVICE_URL=http://localhost:8083

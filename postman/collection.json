    {
      "name": "2. Integration & Error Handling (IT01-IT07)",
      "description": "Bo kiem thu Consumer (booking) goi Provider (pitch) qua Service ID va xu ly loi tich hop. Yeu cau: da chay thu muc 1 de co token.",
      "item": [
        {
          "name": "IT01 - Dat san thanh cong (201, totalPrice = so gio x don gia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bookingUrl}}/api/v1/bookings",
            "description": "San 1 gia 300.000d/gio, dat 1,5 gio -> totalPrice = 450.000. Log Booking Service in dong 'Pitch Service tra ve san 1: gia ... trang thai hoat_dong'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pitchId\": \"{{pitchId}}\",\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sinh khung gio 90 phut ngau nhien trong nam 2027 de chay lai nhieu lan khong bi trung lich",
                  "const day = 1 + Math.floor(Math.random() * 28);",
                  "const month = 1 + Math.floor(Math.random() * 12);",
                  "const hour = 6 + Math.floor(Math.random() * 12);",
                  "const pad = (n) => String(n).padStart(2, '0');",
                  "const start = `2027-${pad(month)}-${pad(day)}T${pad(hour)}:00:00`;",
                  "const end = `2027-${pad(month)}-${pad(day)}T${pad(hour + 1)}:30:00`;",
                  "pm.collectionVariables.set('slotStart', start);",
                  "pm.collectionVariables.set('slotEnd', end);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', body.id);",
                  "pm.test('Trang thai don la cho_duyet', () => pm.expect(body.status).to.eql('cho_duyet'));",
                  "pm.test('totalPrice = 1,5 gio x don gia Provider', function () {",
                  "    const start = new Date(pm.collectionVariables.get('slotStart'));",
                  "    const end = new Date(pm.collectionVariables.get('slotEnd'));",
                  "    const hours = (end - start) / 3600000;",
                  "    pm.expect(Number(body.totalPrice)).to.be.above(0);",
                  "    pm.expect(Number(body.totalPrice)).to.eql(hours * 300000);",
                  "});"
                ]
              }
            }
          ]
        },

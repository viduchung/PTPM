            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/v1/auth/register",
            "description": "Tai khoan tao qua API luon co vai tro 'user' (khong cho client tu khai role).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"khachhang01\",\n  \"email\": \"khachhang01@gmail.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Nguyen Van Khach Hang\",\n  \"phone\": \"0912345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created hoac 400 neu tai khoan da ton tai', function () {",
                  "    pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
